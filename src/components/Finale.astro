---
import { links } from '../data/perfil.js';
---

<section id="contacto" class="section">
  <div class="container">
    <div class="panel finale">
      <p class="eyebrow">Contacto</p>
      <h2 class="section-title">¿Jugamos <span class="gold-text">juntos</span>?</h2>
      <p class="section-lead">Mazmorras, bandas o simplemente charlar de WoW. Encuéntrame aquí.</p>
      <div class="actions">
        {
          links.map((l, i) => (
            <a class={`btn ${i === 0 ? 'btn-gold' : 'btn-ghost'}`} href={l.href} target="_blank" rel="noopener">
              {l.label}
            </a>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .finale {
    padding: clamp(2.5rem, 7vw, 5rem) 1.5rem;
    text-align: center;
    display: grid;
    justify-items: center;
    gap: 1rem;
    overflow: hidden;
    border-color: rgb(248 183 0 / 0.25);
    background:
      radial-gradient(40rem 18rem at 50% 0%, rgb(248 183 0 / 0.14), transparent 70%),
      linear-gradient(180deg, var(--panel-2), var(--panel));
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 1rem;
  }
</style>
