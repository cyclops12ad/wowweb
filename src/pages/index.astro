---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Characters from '../components/Characters.astro';
import Progress from '../components/Progress.astro';
import Journal from '../components/Journal.astro';
import Finale from '../components/Finale.astro';
import { main } from '../data/perfil.js';
---

<BaseLayout title={`${main.name} · WoWeb`} description={`${main.name}, ${main.spec} ${main.className} en ${main.region}-${main.realm}.`}>
  <Hero />
  <Characters />
  <Progress />
  <Journal />
  <Finale />
</BaseLayout>
